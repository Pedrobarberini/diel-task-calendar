{
  "name": "diel-task-calendar",
  "version": "1.0.0",
  "private": true,
  "description": "Task calendar for the Diel technical challenge, junior and mid-level scope.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @diel/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "seed": "pnpm --filter @diel/api seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "pnpm --filter @diel/api dev",
    "dev:rest": "pnpm --filter @diel/web dev --mode rest"
  },
  "devDependencies": {
    "prettier": "^3.8.2"
  }
}
